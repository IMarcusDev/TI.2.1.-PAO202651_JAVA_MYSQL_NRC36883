<%@ page pageEncoding="UTF-8" %>
<%-- Avisos de la pantalla: verde con el mensaje de éxito, rojo con el error. --%>
<c:if test="${not empty mensaje}">
    <div class="aviso aviso--exito" role="status"><c:out value="${mensaje}"/></div>
</c:if>
<c:if test="${not empty error}">
    <div class="aviso aviso--error" role="alert"><c:out value="${error}"/></div>
</c:if>

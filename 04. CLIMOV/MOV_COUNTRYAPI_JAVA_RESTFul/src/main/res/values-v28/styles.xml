<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 9+: TalkBack anuncia títulos y subtítulos como encabezados -->
    <style name="Titulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Subtitulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/azul</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
</resources>

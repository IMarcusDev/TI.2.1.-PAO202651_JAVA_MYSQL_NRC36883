<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera azul con la marca -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/azul"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="40dp"
            android:paddingEnd="24dp"
            android:paddingBottom="76dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/logo_fondo"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_globo"
                app:tint="@color/blanco" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/blanco"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/login_subtitulo"
                android:textColor="@color/texto_sobre_azul"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Formulario sobre la cabecera -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-52dp"
            android:layout_marginEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Titulo"
                    android:text="@string/login_titulo" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/usuario"
                    app:startIconDrawable="@drawable/ic_usuario">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campoUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="username"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/clave"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_clave">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campoClave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <include layout="@layout/aviso" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonIngresar"
                    style="@style/BotonPrimario"
                    android:layout_width="match_parent"
                    android:layout_marginTop="20dp"
                    android:text="@string/ingresar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Servidor al que se conecta la app (se puede cambiar sin recompilar) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Subtitulo"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/servidor"
                    app:drawableStartCompat="@drawable/ic_servidor"
                    app:drawableTint="@color/azul" />

                <TextView
                    android:id="@+id/textoServidor"
                    style="@style/TextoSuave"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:textIsSelectable="true" />

                <ec.edu.monster.vista.IndicadorServidor
                    android:id="@+id/indicadorLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonServidor"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="48dp"
                    android:text="@string/cambiar_servidor"
                    android:textColor="@color/azul" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Barra superior azul (como la del diseño de referencia) -->
    <style name="BarraSuperior" parent="Widget.Material3.Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
        <item name="android:background">@color/azul</item>
        <item name="titleTextColor">@color/blanco</item>
        <item name="subtitleTextColor">@color/texto_sobre_azul</item>
        <item name="android:theme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>

    <style name="Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/blanco</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/azul</item>
        <item name="hintTextColor">@color/azul</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="startIconTint">@color/texto_suave</item>
    </style>

    <style name="CampoLista" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/azul</item>
        <item name="hintTextColor">@color/azul</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>

    <style name="BotonPrimario" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="backgroundTint">@color/azul</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="BotonSecundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/azul</item>
        <item name="strokeColor">@color/azul</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Titulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Subtitulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/azul</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextoSuave">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/texto_suave</item>
    </style>

    <!-- Encabezado celeste de las tablas -->
    <style name="EncabezadoTabla">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/azul_claro</item>
        <item name="android:padding">10dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/azul</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CeldaTabla">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="Aviso">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:visibility">gone</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>

    <style name="ChipRegion" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_fondo</item>
        <item name="android:textColor">@color/chip_texto</item>
        <item name="chipStrokeColor">@color/chip_borde</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>
